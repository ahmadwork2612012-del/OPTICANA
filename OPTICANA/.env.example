# Production can point directly to the API domain, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Local development proxy target for the Vite /api proxy.
VITE_DEV_API_TARGET=http://localhost:4000

# Keep / for a normal domain. Set /OPTICANA/ only when deploying under that sub-path.
VITE_BASE_PATH=/
