generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  WHATSAPP
  CARD
  ONLINE
  OTHER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  REPAIR
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT
  DAMAGE
  INITIAL
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  VOID
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentType {
  SALE_PAYMENT
  PURCHASE_PAYMENT
  EXPENSE_PAYMENT
  REPAIR_PAYMENT
  OTHER
}

enum RepairStatus {
  RECEIVED
  PENDING
  DIAGNOSING
  WAITING
  IN_PROGRESS
  READY
  DELIVERED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryMovements InventoryMovement[]
  approvedReviews    Review[]            @relation("ReviewApprovedBy")
  createdPayments    Payment[]           @relation("PaymentCreatedBy")
  media              Media[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([role, isActive])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  whatsapp  String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders   Order[]
  reviews  Review[]
  payments Payment[]
  repairs  Repair[]

  @@index([phone])
  @@index([email])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  showOnStore Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id            String        @id @default(cuid())
  sku           String        @unique
  name          String
  slug          String        @unique
  description   String?
  price         Decimal       @db.Decimal(12, 2)
  oldPrice      Decimal?      @db.Decimal(12, 2)
  purchasePrice Decimal?      @db.Decimal(12, 2)
  stock         Int           @default(0)
  reorderLevel  Int           @default(0)
  color         String?
  material      String?
  size          String?
  rating        Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount   Int           @default(0)
  status        ProductStatus @default(DRAFT)
  showOnStore   Boolean       @default(true)
  featured      Boolean       @default(false)
  isNew         Boolean       @default(false)
  isSale        Boolean       @default(false)
  categoryId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  orderItems         OrderItem[]
  reviews            Review[]
  inventoryMovements InventoryMovement[]
  offers             Offer[]
  purchaseItems      PurchaseItem[]
  repairs            Repair[]
  repairParts         RepairPart[]

  @@index([categoryId])
  @@index([status, showOnStore])
  @@index([featured])
  @@index([isNew])
  @@index([isSale])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Offer {
  id          String    @id @default(cuid())
  title       String
  description String?
  productId   String?
  percentage  Decimal?  @db.Decimal(5, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([isActive, startsAt, endsAt])
  @@index([productId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerId      String?
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(WHATSAPP)
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  currency        String        @default("EGP")
  notes           String?
  source          String        @default("store")
  stockApplied    Boolean       @default(false)
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(UNPAID)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]

  @@index([customerId])
  @@index([status, createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String
  sku       String?
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
  costPrice Decimal @default(0) @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Review {
  id           String       @id @default(cuid())
  productId    String
  customerId   String?
  approvedById String?
  rating       Int
  comment      String?
  status       ReviewStatus @default(PENDING)
  featured     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  approvedBy User?     @relation("ReviewApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([status, featured])
  @@index([customerId])
}

model InventoryMovement {
  id         String                @id @default(cuid())
  productId  String
  userId     String?
  type       InventoryMovementType
  quantity   Int
  stockAfter Int
  note       String?
  createdAt  DateTime              @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([type, createdAt])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  whatsapp  String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  payments  Payment[]

  @@index([name])
  @@index([phone])
}

model Purchase {
  id              String         @id @default(cuid())
  invoiceNumber   String         @unique
  supplierId      String?
  status          PurchaseStatus @default(RECEIVED)
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  paidAmount      Decimal        @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal        @default(0) @db.Decimal(12, 2)
  paymentStatus   PaymentStatus  @default(UNPAID)
  stockApplied    Boolean        @default(false)
  source          String         @default("admin")
  notes           String?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    PurchaseItem[]
  payments Payment[]

  @@index([supplierId])
  @@index([status, createdAt])
  @@index([paymentStatus])
}

model PurchaseItem {
  id            String  @id @default(cuid())
  purchaseId    String
  productId     String?
  name          String
  sku           String?
  quantity      Int
  purchasePrice Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([productId])
}

model Expense {
  id            String        @id @default(cuid())
  expenseNumber String        @unique
  title         String
  category      String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  source        String        @default("admin")
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments Payment[]

  @@index([category])
  @@index([createdAt])
}

model Repair {
  id            String       @id @default(cuid())
  repairNumber  String       @unique
  customerId    String?
  productId     String?
  title         String
  description   String?
  itemType      String?
  problem       String?
  diagnosis     String?
  receivedDate  DateTime     @default(now())
  dueDate       DateTime?
  status        RepairStatus @default(PENDING)
  estimatedCost Decimal      @default(0) @db.Decimal(12, 2)
  finalCost     Decimal      @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal      @default(0) @db.Decimal(12, 2)
  notes         String?
  imageUrl      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  payments Payment[] @relation("RepairPayments")
  parts    RepairPart[]

  @@index([customerId])
  @@index([productId])
  @@index([status, createdAt])
  @@index([dueDate])
  @@index([receivedDate])
}

model Payment {
  id     String        @id @default(cuid())
  amount Decimal       @db.Decimal(12, 2)
  type   PaymentType   @default(OTHER)
  method PaymentMethod @default(CASH)
  source String        @default("admin")

  customerId String?
  supplierId String?
  orderId    String?
  purchaseId String?
  expenseId  String?

  repairId String?

  createdById       String?
  reversedPaymentId String?
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchase  Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  expense   Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  repair    Repair?   @relation("RepairPayments", fields: [repairId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  reversedPayment Payment?  @relation("PaymentReversal", fields: [reversedPaymentId], references: [id], onDelete: SetNull)
  reversals       Payment[] @relation("PaymentReversal")

  @@index([customerId, createdAt])
  @@index([supplierId, createdAt])
  @@index([orderId])
  @@index([purchaseId])
  @@index([expenseId])
  @@index([repairId])
  @@index([createdById, createdAt])
  @@index([reversedPaymentId])
  @@index([type, createdAt])
}

model StoreSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson Json
  updatedAt DateTime @updatedAt
}

model StoreContent {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson Json
  updatedAt DateTime @updatedAt
}


model RepairPart {
  id        String   @id @default(cuid())
  repairId  String
  productId String
  quantity  Int
  unitCost  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  repair  Repair  @relation(fields: [repairId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([repairId])
  @@index([productId])
}

model Media {
  id           String   @id @default(cuid())
  name         String
  url          String
  mimeType     String?
  size         Int      @default(0)
  folder       String   @default("general")
  entityType   String?
  entityId     String?
  isPrimary    Boolean  @default(false)
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([folder])
  @@index([entityType, entityId])
  @@index([uploadedById, createdAt])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String?
  title      String
  message    String
  type       String   @default("info")
  entityType String?
  entityId   String?
  priority   String   @default("normal")
  read       Boolean  @default(false)
  readAt     DateTime?
  source     String   @default("system")
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([source, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}
