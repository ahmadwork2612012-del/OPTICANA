NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opticana?schema=public"
JWT_SECRET="replace-this-with-a-long-random-secret-at-least-32-characters"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

MEDIA_STORAGE_DIR="./uploads"
MEDIA_BASE_URL="/uploads"

ADMIN_EMAIL="admin@opticana.local"
ADMIN_PASSWORD="change-this-to-a-strong-password"
ADMIN_NAME="OPTICANA Admin"

# Cloudflare R2 media storage (required on Vercel: its filesystem is read-only).
# When all five are set, images upload directly from the browser to R2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="opticana-media"
# Public URL of the bucket: custom domain (e.g. https://media.example.com) or the r2.dev URL.
R2_PUBLIC_BASE_URL=""
